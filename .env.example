# Copy to .env and edit. Real environment variables win over this file.
# Never commit .env or paste keys into logs.

# Optional. Leave empty for offline (rule-based) mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# auto = use the LLM when a key is set; offline = never call the LLM
LLM_MODE=auto

DB_PATH=data/feedback.db
LEDGER_PATH=data/ledger.jsonl

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
OPEN_LOG_WINDOW=1

PORT=8000
API_URL=http://127.0.0.1:8000
